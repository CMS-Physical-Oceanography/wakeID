%% FINAL WAKE IDENTIFICATION AND ENERGY ANALYSIS
% Remove the slowly varying pressure signal, create a sliding-window
% spectrogram, identify boat wakes with imgNet, and compare wake energy with
% wind-wave energy and measured wind speed.

%% 1. LOAD PRESSURE DATA, TRAINED NETWORK, AND WIND DATA
clear all; close all;             % Clear workspace variables and close figures
load("C:\Users\cls7049\OneDrive - UNC-Wilmington\WakeProjData\Summer2022\ICW_survey_20220922\rbr_pressure_CMSsouth_2022.mat") %Load Data
load("C:\Users\cls7049\OneDrive - UNC-Wilmington\WakeProjData\Summer2023\imgNet_v4.mat")      %Load Network
load("C:\Users\cls7049\OneDrive - UNC-Wilmington\WakeProjData\Summer2023\Met_Data\Winds.mat") % Load Met data

P0=data(2).pres;                  % Pressure record from the surface sensor, in DBar
P = P0*0.99;                      % Pressure converted from DBar to meters
T=data(2).time;                   % MATLAB serial-date pressure timestamps
clear data                        % Remove the larger source structure from memory

%% 2. REMOVE THE MEAN AND LOW-FREQUENCY PRESSURE TREND
fs = 16.66;                       % Pressure sampling frequency [Hz]
Pmean = mean(P);                  % Mean pressure over the full deployment
F= hanning(round(32*fs));         % 32-second Hann smoothing window
F=F./sum(F);                      % Normalize the smoothing window
Pconv= conv(P-Pmean,F,"same");   % Slowly varying pressure component
P0= P-Pconv-Pmean;                % Perturbation pressure used for wake analysis

%% 3. DEFINE TIME, SEGMENT, AND SPECTROGRAM PARAMETERS
% Divide the pressure record into approximately 10-minute segments. Each
% segment becomes a time-frequency image that is passed through imgNet.
DataStart = datetime(datestr(T(1)));
DataStartVec = datevec(DataStart); % Components of the first sample's date

vect = datetime(datevec(T));       % Pressure timestamps as datetime values

LP= length(P);                    % Total number of pressure samples
seg = round((LP/fs)/600);         % Number of approximately 10-minute segments
N = round(LP/seg);                % Samples in each segment

Ts = 32;                          % Spectrogram window duration [s]
dTs = 0.5;                        % Step between adjacent windows [s]
L= round(Ts*fs);                  % Spectrogram window length [samples]
Olap= L-round(dTs*fs);            % Number of overlapping samples
dfp= fs/L;                        % Frequency-bin width [Hz]


%% 4. INITIALIZE DAILY, SEGMENT, AND INDIVIDUAL-WAKE OUTPUTS
dy= 1;                            % Current day index
timeu = unique(dateshift(vect,'start','days')); % Unique deployment dates
Dailynumb = zeros(1,length(timeu));              % Number of wakes per day

wkeEind = [];% energy of individual wakes in 10 min window
wkeEseg = [];% energy of all wakes in current 10 min window
wkeEday = zeros(1,length(timeu)); % Total detected wake energy per day

wndEday = zeros(1,length(timeu)); % Non-wake/wind-wave energy per day
wndEseg = [];                     % Non-wake energy in each segment
vidNum  = [];% which video are these wakes from

wkeIind = [];% individual wake indices in spectrogram of current video
wkeTind = [];% same with time in seconds relative to dataStart
wkeIseg = 1:N:N*seg;% 10 min segment indices in spectrogram of current video
wkeTseg = T(wkeIseg);% same with time in seconds relative to dataStart

%% 5. CREATE FIGURES USED BY THE OPTIONAL PLOTTING CODE
Fig4= figure;
Fig1 = figure;
Fig3=figure;
Fig6 = figure;
Fig5 = figure;
%% 6. PROCESS EACH 10-MINUTE PRESSURE SEGMENT
for ii = 1:2
    t1 = T(1+N*(ii-1):N*ii);  % Timestamps in the current segment
    P1 = P0(1+N*(ii-1):N*ii); % Perturbation pressure in current segment

    % Create a 0-1.5 Hz power spectral-density spectrogram. Columns are
    % time bins and rows are frequency bins.
    [s,f,tfs]=spectrogram(P1,hamming(L),Olap,0:fs/L:1.5,fs,"yaxis",'psd');
    Nf = length(f);             % Number of frequency bins/image rows
    Nt = length(tfs);           % Number of time bins/image columns
    S = (s.*conj(s)/(L*fs));    % Spectral power used for energy calculations

    % Scale spectral power to the 8-bit grayscale image expected by imgNet.
    C = 255 - round(((S-0)/(.00001-0)).*255);
    C= uint8(C);

    % Classify every pixel and keep wake probabilities of at least 75%.
    act = activations(imgNet,C,'softmax');
    Bw = act(1:Nf,1:Nt,2)>=.75;
    CleanC= bwareaopen(Bw,100); % Remove connected regions under 100 pixels
    [labim,number] = bwlabel(CleanC); % Label separate detected regions
    labimS = max(labim,[],1);   % Collapse labels to one value per time column

    % Find the first and last spectrogram columns of each detected wake.
    startTs = [];
    endTs   = [];
    for ww = 1:max(labimS(:))
        startTs(ww) = find(labimS==ww,1,'first');
        endTs(ww)   = find(labimS==ww,1,'last');
    end
    % Expand the wake timeline into a mask with the size of the spectrogram.
    whatwake = labimS>0;
    wakeMask = repmat(whatwake,Nf,1);
    % The block below is an older, disabled wake-boundary method.
    % % find start/end indices of wakes
    % iswake = diff(whatwake);
    % firstwkeind=find(iswake~=0,1,'first');
    % lastwkeind=find(iswake~=0,1,'last');
    % if iswake(firstwkeind)==-1
    %     iswake(1)=1;
    % end
    % if iswake(lastwkeind)==1
    %     iswake(end)=-1;
    % end
    % startTs= find(iswake>0)+1;
    % endTs  = find(iswake<0);
    % stats1 = regionprops(CleanC,'centroid');
    % stats2 = regionprops(CleanC,'MajorAxisLength');
    % stats3 = regionprops(CleanC,'MinorAxisLength');
    % centers = cat(1,stats1.Centroid);
    % Fwidth = cat(1,stats3.MinorAxisLength);
    % Twidth = cat(1,stats2.MajorAxisLength);
    % Store wake bounds and integrate wake and non-wake spectral energy.
    vidNum  = cat(1,vidNum, 0*startTs'+ii); % Segment containing each wake
    wkeIind = cat(1,wkeIind,[startTs', endTs']); % Wake image-column bounds
    wkeTind = cat(1,wkeTind,[tfs(startTs)', tfs(endTs)']+N*(ii-1)/fs); % Bounds [s]
    wkeEseg = cat(1,wkeEseg, sum(sum(S.*wakeMask))*dfp*dTs); % Wake energy/segment
    wndEseg = cat(1,wndEseg, sum(sum(S.*~wakeMask))*dfp*dTs);% Wind energy/segment
    E = sum(sum(S))*dfp*dTs;    % Total spectral energy in this segment

    % Calculate the energy of each individual detected wake.
    for jj = 1:number
        startTind = startTs(jj);
        endTind   = endTs(jj);
        startTsec = tfs(startTind); 
        endTsec   = tfs(endTind); 
        Ef   = sum(S(:,:),1).*dfp; % Frequency-integrated energy versus time
        Ewke = sum(Ef(startTind:endTind))*dTs;
        indP = P1(round(startTind*dTs*fs):round(endTind*dTs*fs)); % Wake pressure
        %data.DD(dy).seg(ii).WkeT(jj) = DataStart+startTsec/24/60/60;
        %data.DD(dy).seg(ii).WkeE(jj) = Ewke;
        wkeEind = cat(1,wkeEind,Ewke);
        Dailynumb(dy) = Dailynumb(dy) + number;
        wkeEday(dy) = wkeEday(dy) + Ewke;
        E = E - Ewke;
    end
    wndEday(dy) = wndEday(dy) +E; % Assign remaining energy to wind waves

    % Advance the daily accumulator when the segment crosses midnight.
    dyswitch = datetime(datevec(T(1+N*(ii-1))));
    dyswitch2 = datetime(datevec(T(1+N*(ii))));
    Dys = dyswitch.Day;
    Dys2 = dyswitch2.Day;
    if Dys~=Dys2
        dy=dy+1;
    end
    
    if ii == seg/2
    DISP('50%')
    end

