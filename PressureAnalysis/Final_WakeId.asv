%% 7. CONVERT ENERGY TO WAVE HEIGHT AND APPLY HOURLY SMOOTHING
% NOTE: The next line is entirely commented out, including the WveH
% assignment. WveH must therefore already exist or later code will error.
% save('D:\WakeID_Summer2023\Final_Wake_Data\WveWndData.mat','WveH')
WveH = 100*4*sqrt(wkeEseg/Nt/dTs);
WndH = 100*4*sqrt(wndEseg/Nt/dTs); % Wind-wave height estimate [cm]
ActE = 1024*9.8*(wkeEseg/Nt/dTs);  % Wake energy scaled by density and gravity

Nfilt = round(3600/(Nt*dTs));       % One-hour filter length in segments
filter= hamming(Nfilt); filter = filter./sum(filter); % Normalized smoother
WveHs = conv(WveH,filter,'valid');  % Hourly-smoothed wake height
WndHs = conv(WndH,filter,'valid');  % Hourly-smoothed wind-wave height
wkeTs = wkeTseg(Nfilt/2:end-Nfilt/2); % Timestamps aligned to convolution

dTwind = (MSNBt(2)-MSNBt(1))*86400; % Wind-data sampling interval [s]
Nfilt = round(3600/dTwind);          % One-hour wind filter length
filter= hamming(Nfilt); filter = filter./sum(filter);
MSNBwindS = conv(MSNBwindSpeedmps,filter,'valid'); % Smoothed wind speed
MSNBwindD = conv(MSNBwindDir,filter,'valid');      % Smoothed wind direction
MSNBts = MSNBt(Nfilt/2:end-Nfilt/2);              % Aligned timestamps

%% 8. PLOT WAKE HEIGHT, WIND-WAVE HEIGHT, AND WIND SPEED
figure7 = figure('units','normalized','outerposition',[0 0 1 1]);
axs8 = axes; % Right-side axis for wind speed
plot(MSNBts,abs(cosd(MSNBwindD).*MSNBwindS),'-k','linewidth',2) % Wind component
axs7=axes;   % Left-side axis for wake and wind-wave heights
p2 = plot([0 0],[-100 -101],'-k','linewidth',2);hold on
p0 = plot(wkeTs,WveHs,'-b','linewidth',2);
p1 = plot(wkeTs,WndHs,'-r','linewidth',2);

legend([p0 p1 p2],'Averaged Wake Height','Averaged Wind Wave Height','MSNB Wind Speed')
title("Wind and Wake Wave Heights Against Time",'Interpreter','latex','FontSize',FontSizeTitle)
xlabel("$t$ [mm/dd]", 'Interpreter','latex','FontSize',FontsizeLabel)
ylabel("$H$ [cm]", 'Interpreter','latex','FontSize',FontsizeLabel)
set(axs7, 'xlim',[T(1) T(end)],'tickdir','out','fontsize',20,'box','off','color','none')
datetick(axs7,'x','mm/dd','keeplimits','keepticks')

set(axs8,'color','none','xtick',[],'yaxislocation','right','tickdir','out','fontsize',20,'box','off','position',get(axs7,'position'),'xlim',[T(1) T(end)])
ylabel(axs8,'$U_\mathrm{wind}$ [m/s]','interpreter','latex','Fontsize',FontsizeLabel)
